// use prisma-8
enum ApplicationStatus {
  SAVED
  PREPARING
  APPLIED
  INTERVIEW
  OFFER
  CLOSED
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum UserRole {
  STUDENT
  ADMIN
}

enum InformationalInterviewStatus {
  PREPARING
  SCHEDULED
  COMPLETED
}

enum CareerDocumentType {
  RESUME
  COVER_LETTER
}

model User {
  id                       Int                       @id @default(autoincrement())
  email                    String                    @unique
  passwordHash             String
  firstName                String
  lastName                 String?
  role                     UserRole                  @default(STUDENT)
  currentRole              String?
  targetRole               String?
  weeklyGoal               Int?
  createdAt                DateTime                  @default(now())
  updatedAt                temporal.updatedAt()
  applications             Application[]
  contacts                 Contact[]
  employers                Employer[]
  tasks                    Task[]
  informationalInterviews  InformationalInterview[]
  careerDocuments          CareerDocument[]
  jobInterviewPreparations JobInterviewPreparation[]

  @@map("user")
}

model Employer {
  id           Int                  @id @default(autoincrement())
  name         String
  website      String?
  industry     String?
  location     String?
  notes        String?
  userId       Int
  createdAt    DateTime             @default(now())
  updatedAt    temporal.updatedAt()
  user         User                 @relation(fields:[userId], references:[id], onDelete: Cascade)
  applications Application[]
  contacts     Contact[]

  @@map("employer")
}

model Contact {
  id                      Int                      @id @default(autoincrement())
  firstName               String
  lastName                String?
  email                   String?
  phone                   String?
  jobTitle                String?
  notes                   String?
  lastContacted           DateTime?
  nextFollowUp            DateTime?
  userId                  Int
  employerId              Int?
  user                    User                     @relation(fields:[userId], references:[id], onDelete: Cascade)
  employer                Employer?                @relation(fields:[employerId], references:[id], onDelete: SetNull)
  applications            Application[]
  tasks                   Task[]
  informationalInterviews InformationalInterview[]
  createdAt               DateTime                 @default(now())
  updatedAt               temporal.updatedAt()

  @@map("contact")
}

model Application {
  id                       Int                       @id @default(autoincrement())
  company                  String
  position                 String
  location                 String?
  status                   ApplicationStatus         @default(SAVED)
  deadline                 DateTime?
  appliedAt                DateTime?
  notes                    String?
  userId                   Int
  employerId               Int?
  contactId                Int?
  user                     User                      @relation(fields:[userId], references:[id], onDelete: Cascade)
  employer                 Employer?                 @relation(fields:[employerId], references:[id], onDelete: SetNull)
  contact                  Contact?                  @relation(fields:[contactId], references:[id], onDelete: SetNull)
  tasks                    Task[]
  careerDocuments          CareerDocument[]
  jobInterviewPreparations JobInterviewPreparation[]
  createdAt                DateTime                  @default(now())
  updatedAt                temporal.updatedAt()

  @@map("application")
}

model Task {
  id            Int                  @id @default(autoincrement())
  title         String
  description   String?
  dueDate       DateTime?
  status        TaskStatus           @default(PENDING)
  userId        Int
  applicationId Int?
  contactId     Int?
  user          User                 @relation(fields:[userId], references:[id], onDelete: Cascade)
  application   Application?         @relation(fields:[applicationId], references:[id], onDelete: Cascade)
  contact       Contact?             @relation(fields:[contactId], references:[id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     temporal.updatedAt()

  @@map("task")
}

model InformationalInterview {
  id                   Int                          @id @default(autoincrement())
  contactName          String
  role                 String
  company              String?
  scheduledFor         DateTime
  status               InformationalInterviewStatus @default(PREPARING)
  preparationQuestions String[]                     @default([])
  keyTakeaway          String?
  recommendedAction    String?
  referral             String?
  thankYouSent         Boolean
  nextFollowUp         DateTime?
  userId               Int
  contactId            Int?
  user                 User                         @relation(fields:[userId], references:[id], onDelete: Cascade)
  contact              Contact?                     @relation(fields:[contactId], references:[id], onDelete: SetNull)
  createdAt            DateTime                     @default(now())
  updatedAt            temporal.updatedAt()

  @@map("informationalInterview")
}

model CareerDocument {
  id               Int                  @id @default(autoincrement())
  title            String
  documentType     CareerDocumentType
  version          String
  fileName         String?
  mimeType         String?
  fileSizeBytes    Int?
  storageReference String
  applicationId    Int?
  userId           Int
  user             User                 @relation(fields:[userId], references:[id], onDelete: Cascade)
  application      Application?         @relation(fields:[applicationId], references:[id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        temporal.updatedAt()

  @@index([userId])
  @@index([applicationId])
  @@map("careerDocument")
}

model JobInterviewPreparation {
  id                Int                  @id @default(autoincrement())
  company           String
  role              String
  scheduledFor      DateTime?
  companyResearch   String?
  notes             String?
  practiceQuestions String[]             @default([])
  resources         String[]             @default([])
  responsibilities  String[]             @default([])
  skills            String[]             @default([])
  applicationId     Int?
  userId            Int
  user              User                 @relation(fields:[userId], references:[id], onDelete: Cascade)
  application       Application?         @relation(fields:[applicationId], references:[id], onDelete: SetNull)
  createdAt         DateTime             @default(now())
  updatedAt         temporal.updatedAt()

  @@index([userId])
  @@index([applicationId])
  @@map("jobInterviewPreparation")
}
