{
  "name": "careerlaunch",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names API,WEB --prefix-colors blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @careerlaunch/api",
    "dev:web": "npm run dev --workspace @careerlaunch/web",
    "build": "npm run build --workspace @careerlaunch/api && npm run build --workspace @careerlaunch/web",
    "test": "npm run test --workspace @careerlaunch/api && npm run test --workspace @careerlaunch/web",
    "start": "npm run start --workspace @careerlaunch/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
