{
  "name": "careerlaunch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names API,WEB --prefix-colors blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @careerlaunch/api",
    "dev:web": "npm run dev --workspace @careerlaunch/web",
    "build": "npm run build --workspace @careerlaunch/api && npm run build --workspace @careerlaunch/web",
    "test": "cd apps/web && npx tsx --test 'src/**/*.test.ts' && npx vitest run --environment jsdom",
    "start": "npm run start --workspace @careerlaunch/api",
    "db:migrate": "npm run db:migrate --workspace @careerlaunch/api",
    "db:seed": "npm run db:seed --workspace @careerlaunch/api",
    "db:seed:user-demo": "npm run db:seed:user-demo --workspace @careerlaunch/api",
    "db:reset": "npm run db:reset --workspace @careerlaunch/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
